<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Landrys_Loop_Checkout_System.Module.Win</RootNamespace>
    <AssemblyName>Landrys_Loop_Checkout_System.Module.Win</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <Deterministic>false</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Configurations>Debug;Release;EasyTest</Configurations>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'EasyTest'">
    <DefineConstants>$(DefineConstants);EASYTEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="**\*.bak" />
    <None Remove="**\*.bak" />
    <EmbeddedResource Remove="**\*.bak" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Model.DesignedDiffs.xafml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DevExpress.ExpressApp" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.Chart.Win" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.CodeAnalysis" Version="26.1.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="DevExpress.ExpressApp.FileAttachment.Win" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.ReportsV2.Win" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.Scheduler.Win" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.Security" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.Validation.Win" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.Win" Version="26.1.3" />
    <PackageReference Include="DevExpress.Win" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.Xpo" Version="26.1.3" />
    <PackageReference Include="DevExpress.Persistent.Base" Version="26.1.3" />
    <PackageReference Include="DevExpress.Persistent.BaseImpl.Xpo" Version="26.1.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Landrys_Loop_Checkout_System.Module\Landrys_Loop_Checkout_System.Module.csproj" />
  </ItemGroup>
</Project>
