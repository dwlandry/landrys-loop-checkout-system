<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Landrys_Loop_Checkout_System.Win</RootNamespace>
    <AssemblyName>Landrys_Loop_Checkout_System.Win</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>LLC.ico</ApplicationIcon>
    <Deterministic>false</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Configurations>Debug;Release</Configurations>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="**\*.bak" />
    <None Remove="**\*.bak" />
    <EmbeddedResource Remove="**\*.bak" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="LLC.ico" />
    <Content Include="SampleIoList.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Model.xafml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DevExpress.ExpressApp" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.AuditTrail.Xpo" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.Chart" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.Chart.Win" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.CodeAnalysis" Version="26.1.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="DevExpress.ExpressApp.ConditionalAppearance" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.FileAttachment.Win" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.ReportsV2" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.ReportsV2.Win" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.Scheduler" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.Scheduler.Win" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.Security" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.Security.Xpo" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.Validation" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.Validation.Win" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.ViewVariantsModule" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.Win" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.Win.Design" Version="26.1.3" />
    <PackageReference Include="DevExpress.ExpressApp.Xpo" Version="26.1.3" />
    <PackageReference Include="DevExpress.Persistent.Base" Version="26.1.3" />
    <PackageReference Include="DevExpress.Persistent.BaseImpl.Xpo" Version="26.1.3" />
    <PackageReference Include="DevExpress.Win.Design" Version="26.1.3" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Landrys_Loop_Checkout_System.Module.Win\Landrys_Loop_Checkout_System.Module.Win.csproj" />
